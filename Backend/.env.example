# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/realtime-chat

# Auth
JWT_SECRET=your_jwt_secret_here

# Google OAuth
CLIENT_ID=
CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email (OTP)
EMAIL_USER=
EMAIL_PASS=

# ─── AI (Smart Replies) ───────────────────────────────────────
AI_ENABLED=true
AI_PROVIDER=gemini

# Gemini Developer API — https://ai.google.dev/gemini-api/docs/quickstart
# Create key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
# Models: gemini-2.0-flash, gemini-3.5-flash (see official docs)
GEMINI_MODEL=gemini-3.5-flash
# Optional override (default: https://generativelanguage.googleapis.com/v1beta)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI (set AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude (set AI_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Tuning
AI_SMART_REPLY_MAX_MESSAGES=12
AI_SMART_REPLY_MAX_SUGGESTIONS=3
AI_SMART_REPLY_MAX_LENGTH=120
AI_REQUEST_TIMEOUT_MS=12000
AI_CACHE_TTL_MS=300000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=15
AI_MAX_RETRIES=2
